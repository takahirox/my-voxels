{
  "name": "my-voxels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build packages/visual-sandbox --outDir ../../dist/visual-sandbox --emptyOutDir",
    "test": "node --test dist/packages/*/src/index.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite packages/visual-sandbox --host 127.0.0.1",
    "preview": "vite preview packages/visual-sandbox --outDir ../../dist/visual-sandbox --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "three": "0.185.1"
  }
}
